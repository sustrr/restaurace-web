
---
import type { CollectionEntry } from 'astro:content';

interface Props {
  event: CollectionEntry<'events'>;
  variant?: 'featured' | 'compact';
}

const { event, variant = 'featured' } = Astro.props;

const {
  title,
  startDate,
  endDate,
  description,
  image,
} = event.data;

const formatter = new Intl.DateTimeFormat('cs-CZ', {
  timeZone: 'Europe/Prague',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const dateLabel = endDate
  ? `${formatter.format(startDate)} – ${formatter.format(endDate)}`
  : formatter.format(startDate);
---

{variant === 'featured' ? (
  <article class="event-card event-card--featured">
    <div class="event-card__media">
      {image && (
        <img
          src={image}
          alt={title}
          class="event-card__image"
          loading="lazy"
        />
      )}
    </div>

    <div class="event-card__content">
      <p class="event-card__eyebrow">Sezónní nabídka</p>
      <p class="event-card__date">{dateLabel}</p>

      <h3 class="event-card__title">{title}</h3>

      <p class="event-card__description">{description}</p>

      <a href="/rezervace/" class="event-card__button">
        Rezervovat stůl
      </a>
    </div>
  </article>
) : (
  <article class="event-card-compact">
    <div class="event-card-compact__content">
      <p class="event-card-compact__date">{dateLabel}</p>

      <h3 class="event-card-compact__title">{title}</h3>

      <p class="event-card-compact__description">{description}</p>
    </div>

    <a
      href="/rezervace/"
      class="event-card-compact__link"
      aria-label={`Rezervovat stůl – ${title}`}
    >
      Rezervovat stůl
      <span aria-hidden="true">↗</span>
    </a>
  </article>
)}
