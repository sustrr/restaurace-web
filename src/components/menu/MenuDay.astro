
---
import type { CollectionEntry } from 'astro:content';

type MenuDay =
  CollectionEntry<'weeklyMenu'>['data']['days'][number];

interface Props {
  day: MenuDay;
}

const { day } = Astro.props;

const dayNames = {
  monday: 'Pondělí',
  tuesday: 'Úterý',
  wednesday: 'Středa',
  thursday: 'Čtvrtek',
  friday: 'Pátek',
};
---

<article class="menu-day">
  <h4 class="menu-day__title">
    {dayNames[day.day]}
  </h4>

  {day.closed ? (
    <p class="menu-day__closed">Zavřeno</p>
  ) : (
    <>
      {day.soup && (
        <p class="menu-day__soup">{day.soup}</p>
      )}

      <ul class="menu-day__meals">
        {day.meals.map((meal) => (
          <li class="menu-day__meal">
            <div class="menu-day__meal-info">
              <span class="menu-day__meal-name">
                {meal.name}
              </span>

              {meal.allergens && (
                <small class="menu-day__allergens">
                  Alergeny: {meal.allergens}
                </small>
              )}
            </div>

            <span class="menu-day__price">
              {meal.price} Kč
            </span>
          </li>
        ))}
      </ul>
    </>
  )}
</article>
