---
const allergens = [
  { id: 1, name: "Obiloviny obsahující lepek" },
  { id: 2, name: "Korýši a výrobky z nich" },
  { id: 3, name: "Vejce a výrobky z nich" },
  { id: 4, name: "Ryby a výrobky z nich" },
  { id: 5, name: "Podzemnice olejná (arašídy) a výrobky z nich" },
  { id: 6, name: "Sójové boby a výrobky z nich" },
  { id: 7, name: "Mléko a výrobky z něj (včetně laktózy)" },
  { id: 8, name: "Skořápkové plody a výrobky z nich" },
  { id: 9, name: "Celer a výrobky z něj" },
  { id: 10, name: "Hořčice a výrobky z ní" },
  { id: 11, name: "Sezamová semena a výrobky z nich" },
  { id: 12, name: "Oxid siřičitý a siřičitany" },
  { id: 13, name: "Vlčí bob (lupina) a výrobky z něj" },
  { id: 14, name: "Měkkýši a výrobky z nich" },
];
---

<section class="allergens" aria-labelledby="allergens-title">
  <h2 id="allergens-title">Seznam alergenů</h2>

  <p class="allergens__intro">
    Čísla uvedená u jednotlivých jídel odpovídají následujícím alergenům.
  </p>

  <ol class="allergens__list">
    {allergens.map((allergen) => (
      <li>
        <span class="allergens__number">{allergen.id}</span>
        <span>{allergen.name}</span>
      </li>
    ))}
  </ol>
</section>

<style>
  .allergens {
    max-width: 800px;
    margin: 3rem auto 0;
    padding-top: 2rem;
    border-top: 1px solid rgba(52, 38, 37, 0.2);
  }

  .allergens h2 {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    color: var(--color-deep-brown);
    margin: 0 0 0.75rem;
  }

  .allergens__intro {
    color: var(--color-warm-grey);
    font-size: 0.875rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .allergens__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem 2rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .allergens__list li {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-deep-brown);
  }

  .allergens__number {
    flex: 0 0 1.75rem;
    font-weight: 600;
    color: var(--color-warm-grey);
  }

  @media (max-width: 640px) {
    .allergens__list {
      grid-template-columns: 1fr;
    }
  }
</style>