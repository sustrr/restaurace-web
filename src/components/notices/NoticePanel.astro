
---
import type { CollectionEntry } from 'astro:content';

interface Props {
  notice: CollectionEntry<'notices'>['data'];
}

const { notice } = Astro.props;

const isClosed = notice.type === 'closed';

const reopenDate = notice.reopenDate
  ? new Intl.DateTimeFormat('cs-CZ', {
      timeZone: 'Europe/Prague',
      weekday: 'long',
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    }).format(notice.reopenDate)
  : null;

const hasReopening = Boolean(reopenDate || notice.reopenTime);
---

<div
  class:list={[
    'notice-panel',
    {
      'notice-panel--closed': isClosed,
      'notice-panel--private': !isClosed,
    },
  ]}
  role="status"
>
  <div class="container notice-panel__inner">
    <div class="notice-panel__content">
      <h2 class="notice-panel__title">{notice.title}</h2>

      {notice.reason && (
        <p class="notice-panel__message">{notice.reason}</p>
      )}
    </div>

    {hasReopening && (
      <div class="notice-panel__reopening">
        <p class="notice-panel__eyebrow">Znovu otevíráme</p>

        <p class="notice-panel__datetime">
          {reopenDate && <span>{reopenDate}</span>}

          {reopenDate && notice.reopenTime && (
            <span class="notice-panel__separator" aria-hidden="true">•</span>
          )}

          {notice.reopenTime && <span>{notice.reopenTime}</span>}
        </p>
      </div>
    )}
  </div>
</div>
