
---
import { getCollection } from 'astro:content';

const menus = await getCollection(
  'weeklyMenu',
  ({ data }) => data.published
);

menus.sort((a, b) =>
  b.data.weekStart.localeCompare(a.data.weekStart)
);

const dayNames: Record<string, string> = {
  monday: 'Pondělí',
  tuesday: 'Úterý',
  wednesday: 'Středa',
  thursday: 'Čtvrtek',
  friday: 'Pátek',
};
---

<html lang="cs">
  <head>
    <meta charset="UTF-8" />
    <title>Test poledního menu</title>
  </head>
  <body>
    <h1>Polední menu – test kolekce</h1>

    {menus.map((menu) => (
      <section>
        <h2>{menu.data.title}</h2>
        <p>Týden od: {menu.data.weekStart}</p>

        {menu.data.days.map((day) => (
          <article>
            <h3>{dayNames[day.day]}</h3>

            {day.closed ? (
              <p>Zavřeno</p>
            ) : (
              <>
                {day.soup && <p>Polévka: {day.soup}</p>}

                <ul>
                  {day.meals.map((meal) => (
                    <li>
                      {meal.name} – {meal.price} Kč
                      {meal.allergens && ` (${meal.allergens})`}
                    </li>
                  ))}
                </ul>
              </>
            )}
          </article>
        ))}
      </section>
    ))}
  </body>
</html>
