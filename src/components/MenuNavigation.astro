
---
interface Category {
  id: string;
  title: string;
}

interface Props {
  categories: Category[];
  label?: string;
}

const { categories, label = "Kategorie nabídky" } = Astro.props;
---

<div class="menu-navigation">
  <button
    class="menu-navigation__arrow menu-navigation__arrow--prev"
    type="button"
    aria-label="Předchozí kategorie"
    disabled
  >
    <span aria-hidden="true">‹</span>
  </button>

  <nav class="menu-navigation__links" aria-label={label}>
    {categories.map((category) => (
      <a href={`#${category.id}`}>{category.title}</a>
    ))}
  </nav>

  <button
    class="menu-navigation__arrow menu-navigation__arrow--next"
    type="button"
    aria-label="Další kategorie"
  >
    <span aria-hidden="true">›</span>
  </button>
</div>

<script>
  document.querySelectorAll<HTMLElement>(".menu-navigation").forEach((wrapper) => {
    const nav = wrapper.querySelector<HTMLElement>(".menu-navigation__links");
    const prev = wrapper.querySelector<HTMLButtonElement>(".menu-navigation__arrow--prev");
    const next = wrapper.querySelector<HTMLButtonElement>(".menu-navigation__arrow--next");

    if (!nav) return;

    const links = Array.from(nav.querySelectorAll<HTMLAnchorElement>('a[href^="#"]'));

    const sections = links
      .map((link) => {
        const id = link.getAttribute("href")?.slice(1);
        return id ? document.getElementById(id) : null;
      })
      .filter((section): section is HTMLElement => section !== null);

    const updateArrows = () => {
      const maxScroll = nav.scrollWidth - nav.clientWidth;

      if (prev) prev.disabled = nav.scrollLeft <= 2;
      if (next) next.disabled = nav.scrollLeft >= maxScroll - 2;
    };

    prev?.addEventListener("click", () => {
      nav.scrollBy({ left: -nav.clientWidth * 0.7, behavior: "smooth" });
    });

    next?.addEventListener("click", () => {
      nav.scrollBy({ left: nav.clientWidth * 0.7, behavior: "smooth" });
    });

    nav.addEventListener("scroll", updateArrows, { passive: true });
    window.addEventListener("resize", updateArrows);

    let activeId = "";

    const setActive = (id: string) => {
      if (activeId === id) return;
      activeId = id;

      links.forEach((link) => {
        const active = link.getAttribute("href") === `#${id}`;
        link.classList.toggle("is-active", active);

        if (active) {
          link.setAttribute("aria-current", "location");
        } else {
          link.removeAttribute("aria-current");
        }
      });

      const activeLink = links.find((link) => link.getAttribute("href") === `#${id}`);

      if (activeLink && nav.scrollWidth > nav.clientWidth) {
        const targetLeft =
          activeLink.offsetLeft -
          nav.offsetLeft -
          (nav.clientWidth - activeLink.offsetWidth) / 2;

        nav.scrollTo({ left: targetLeft, behavior: "smooth" });
      }
    };

    const updateActive = () => {
      const activationLine = window.innerHeight * 0.35;

      const current =
        [...sections]
          .reverse()
          .find((section) => section.getBoundingClientRect().top <= activationLine) ??
        sections[0];

      if (current) setActive(current.id);
    };

    let scheduled = false;

    window.addEventListener(
      "scroll",
      () => {
        if (scheduled) return;
        scheduled = true;

        requestAnimationFrame(() => {
          updateActive();
          scheduled = false;
        });
      },
      { passive: true },
    );

    window.addEventListener("resize", updateActive);

    updateArrows();
    updateActive();
  });
</script>
