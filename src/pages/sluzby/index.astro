
---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PhoneContact from "../../components/PhoneContact.astro";

const services = [
  {
    id: "svatby",
    eyebrow: "SVATBY",
    title: "Váš výjimečný den",
    image: "/images/services/svatby.webp",
    alt: "Slavnostně prostřený svatební stůl s květinami a svíčkami",
    paragraphs: [
      "Váš svatební den si zaslouží výjimečnou atmosféru a chvíle, na které budete rádi vzpomínat.",
      "Rádi pro vás připravíme svatební hostinu podle vašich představ. Společně sestavíme slavnostní menu, postaráme se o kvalitní servis a příjemné prostředí, abyste si svůj velký den mohli naplno užít se svými nejbližšími.",
    ],
    features: ["Menu na míru", "Kvalitní servis", "Příjemná atmosféra"],
  },
  {
    id: "narozeniny",
    eyebrow: "NAROZENINY",
    title: "Oslavte s námi",
    image: "/images/services/narozeniny.webp",
    alt: "Narozeninový dort s ovocem a zapálenými svíčkami",
    paragraphs: [
      "Každé narozeniny jsou příležitostí sejít se s těmi, na kterých vám záleží, a užít si společné chvíle.",
      "Ať už plánujete rodinnou oslavu, významné životní jubileum nebo příjemný večer s přáteli, rádi vám pomůžeme připravit oslavu podle vašich představ. Postaráme se o dobré jídlo, nápoje a přátelskou atmosféru, abyste se mohli věnovat především svým hostům.",
    ],
    features: ["Rodinné oslavy", "Životní jubilea", "Setkání s přáteli"],
  },
  {
    id: "firemni-akce",
    eyebrow: "FIREMNÍ AKCE",
    title: "Prostor pro společná setkání",
    image: "/images/services/firemni-akce.webp",
    alt: "Slavnostní občerstvení s jednohubkami a sklenkami sektu",
    paragraphs: [
      "Úspěšná firemní akce není jen o pracovním programu. Je také příležitostí setkat se s kolegy a obchodními partnery v příjemném prostředí.",
      "Rádi pro vás připravíme občerstvení pro firemní setkání, pracovní obědy, školení nebo neformální večírky. Společně vybereme vhodné menu a postaráme se o kvalitní servis, abyste se mohli soustředit na své hosty a průběh celé akce.",
    ],
    features: ["Firemní setkání", "Pracovní obědy", "Neformální večírky"],
  },
  {
    id: "vlastni-akce",
    eyebrow: "VAŠE VLASTNÍ AKCE",
    title: "Máte jiný nápad?",
    image: "/images/services/vlastni-akce.webp",
    alt: "Přátelské setkání u slavnostně prostřeného stolu",
    paragraphs: [
      "Ne každá příležitost potřebuje zvláštní důvod k oslavě. Někdy prostě stačí chuť sejít se, dobře se najíst a strávit příjemný čas společně.",
      "Plánujete tematický večer, rodinné setkání, křtiny, výročí nebo něco úplně jiného? Ozvěte se nám se svým nápadem. Rádi s vámi probereme možnosti a společně najdeme řešení, které bude odpovídat vašim představám.",
    ],
    features: ["Originální nápady", "Individuální domluva", "Akce podle vašich představ"],
  },
];
---

<BaseLayout title="Služby">
  <main class="services-page">
    <div class="services-page__container">
      <header class="services-page__header">
        <p class="services-page__eyebrow">RESTAURACE KŘIŽANOV</p>
        <h1>Oslavy, setkání a výjimečné chvíle</h1>
        <p class="services-page__intro">
          Ať už plánujete svatbu, narozeninovou oslavu nebo firemní setkání,
          rádi vám pomůžeme připravit příjemné chvíle u dobrého jídla.
        </p>
        <p class="services-page__image-note">
  Fotografie na této stránce jsou ilustrační vizualizace vytvořené
  pomocí umělé inteligence a nezachycují skutečné prostory ani
  realizované akce restaurace.
</p>
      </header>

      <div class="services-page__list">
        {
          services.map((service, index) => (
            <section
              class:list={[
                "service",
                { "service--reverse": index % 2 !== 0 },
              ]}
              id={service.id}
            >
              <div class="service__media">
                <img
                  src={service.image}
                  alt={service.alt}
                  width="1400"
                  height="933"
                  loading={index === 0 ? "eager" : "lazy"}
                  decoding="async"
                />
              </div>

              <div class="service__content">
                <p class="service__eyebrow">{service.eyebrow}</p>

                <h2>{service.title}</h2>

                <div class="service__description">
                  {service.paragraphs.map((paragraph) => (
                    <p>{paragraph}</p>
                  ))}
                </div>

                <ul class="service__features">
                  {service.features.map((feature) => (
                    <li>{feature}</li>
                  ))}
                </ul>
              </div>
            </section>
          ))
        }
      </div>
    </div>
  </main>
  <section class="services-cta">
        <div class="services-cta__inner">
          <div class="services-cta__content">
            <p class="services-cta__eyebrow">SPOLEČNĚ TO NAPLÁNUJEME</p>

            <h2>Plánujete oslavu nebo setkání?</h2>

            <p>
              Rádi s vámi probereme vaše představy
              a možnosti jejich realizace.
            </p>
          </div>

          <PhoneContact
            variant="dark"
            description="Zavolejte nám a domluvíme podrobnosti."
          />
        </div>
      </section>
</BaseLayout>

<style>

/* CTA */

  .services-cta {
    margin: 0 -1.5rem;
    padding: 4.5rem 1.5rem;
    background: var(--color-deep-brown);
  }

  .services-cta__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 3rem;
    max-width: 1280px;
    margin: 0 auto;
  }

  .services-cta__content {
    max-width: 750px;
  }

  .services-cta__content h2 {
    margin: 0 0 1rem;
    font-family: var(--font-heading);
    font-size: clamp(2rem, 3.5vw, 3rem);
    font-weight: 500;
    line-height: 1.2;
    color: var(--color-white);
  }

  .services-cta__content > p:last-child {
    margin: 0;
    color: var(--color-cream-white);
    font-size: 1rem;
    line-height: 1.7;
  }


  .services-page {
    padding: 5rem 1.5rem 0;
    background: var(--color-cream-white);
  }

  .services-page__container {
    max-width: 1280px;
    margin: 0 auto;
  }

  .services-page__header {
    max-width: 850px;
    margin: 0 auto 5rem;
    text-align: center;
  }

  .services-page__eyebrow,
  .service__eyebrow,
  .services-cta__eyebrow {
    margin: 0 0 1rem;
    color: var(--color-gold);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.12em;
  }

  .services-page__header h1 {
    margin: 0 0 1.5rem;
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 500;
    line-height: 1.15;
    color: var(--color-deep-brown);
  }

  .services-page__intro {
    max-width: 680px;
    margin: 0 auto;
    color: var(--color-warm-grey);
    font-size: 1.125rem;
    line-height: 1.7;
  }

  .services-page__list {
    display: flex;
    flex-direction: column;
    gap: 5rem;
    padding-bottom: 6rem;
  }

  /* Alternating service rows */

  .service {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
  }

  .service__media {
    overflow: hidden;
    aspect-ratio: 3 / 2;
    border-radius: 10vw 3vw;
    background: #e7dfd0;
  }

  .service__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .service--reverse .service__media {
    order: 2;
    border-radius: 3vw 10vw;
  }

  .service__content {
    min-width: 0;
    padding: 1rem 0;
  }

  .service__eyebrow {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .service__eyebrow::after {
    content: "";
    width: 72px;
    height: 1px;
    background: var(--color-gold);
  }

  .service__content h2 {
    margin: 0 0 1.5rem;
    font-family: var(--font-heading);
    font-size: clamp(2rem, 3.5vw, 3rem);
    font-weight: 500;
    line-height: 1.15;
    color: var(--color-deep-brown);
  }

  .service__description p {
    margin: 0 0 1rem;
    color: var(--color-deep-brown);
    font-size: 1rem;
    line-height: 1.75;
  }

  .service__description p:last-child {
    margin-bottom: 0;
  }

  .service__features {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin: 1.75rem 0 0;
    padding: 1.25rem 0 0;
    border-top: 1px solid rgba(52, 38, 37, 0.15);
    list-style: none;
  }

  .service__features li {
    position: relative;
    padding-left: 1rem;
    color: var(--color-warm-grey);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .service__features li::before {
    content: "";
    position: absolute;
    top: 0.55em;
    left: 0;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-gold);
  }

  @media (max-width: 900px) {
    .service {
      gap: 2rem;
    }

    .service__media {
      aspect-ratio: 4 / 5;
    }

    .services-cta__inner {
      align-items: flex-start;
      flex-direction: column;
      gap: 2rem;
    }
  }

  @media (max-width: 700px) {
    .services-page {
      padding: 3rem 1rem 0;
    }

    .services-page__header {
      margin-bottom: 3rem;
    }

    .services-page__intro {
      font-size: 1rem;
    }

    .services-page__list {
      gap: 3.5rem;
      padding-bottom: 4rem;
    }

    .service {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .service__media,
    .service--reverse .service__media {
      order: 0;
      aspect-ratio: 3 / 2;
      border-radius: 32px 8px 32px 8px;
    }

    .service__content {
      padding: 0;
    }

    .service__content h2 {
      margin-bottom: 1rem;
    }

    .service__features {
      margin-top: 1.25rem;
    }

    .services-cta {
      margin: 0 -1rem;
      padding: 3rem;
    }

    .services-cta__button {
      width: 100%;
    }
  }

  .services-page__image-note {
  max-width: 600px;
  margin: 1rem auto 3rem;
  color: var(--color-warm-grey);
  font-size: 0.8125rem;
  line-height: 1.6;
  text-align: center;
}
</style>
