

---
import type { CollectionEntry } from 'astro:content';

interface Props {
  notice: CollectionEntry<'notices'>['data'];
}

const { notice } = Astro.props;

const isClosed = notice.type === 'closed';
const isAllDay = notice.allDay;

// Datum z CMS ve formátu YYYY-MM-DD
const formatDate = (value?: string | Date | null) => {
  if (!value) return null;

  const date =
    value instanceof Date
      ? value
      : new Date(`${value.slice(0, 10)}T12:00:00Z`);

  if (Number.isNaN(date.getTime())) return null;

  return new Intl.DateTimeFormat('cs-CZ', {
    timeZone: 'Europe/Prague',
    weekday: 'long',
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  }).format(date);
};

const startDate = formatDate(notice.startDate);
const endDate = formatDate(notice.endDate);
const reopenDate = formatDate(notice.reopenDate);

// Obsah pravého panelu
let detailLabel = '';
let detailDate: string | null = null;
let detailTime = '';

if (isClosed && isAllDay) {
  detailLabel = 'Znovu otevíráme';
  detailDate = reopenDate;
  detailTime = notice.reopenTime ?? '';
} else if (isClosed) {
  detailLabel = 'Uzavřeno';
  detailDate = startDate;

  detailTime = [
    notice.startTime,
    notice.endTime,
  ].filter(Boolean).join('–');
} else {
  detailLabel = 'Termín akce';
  detailDate = startDate;

  detailTime = isAllDay
    ? ''
    : [notice.startTime, notice.endTime]
        .filter(Boolean)
        .join('–');
}

const hasDetail = Boolean(detailDate || detailTime);
---



<div
  class:list={[
    'notice-panel',
    {
      'notice-panel--closed': isClosed,
      'notice-panel--event': !isClosed,
    },
  ]}
  role="status"
>
  <div class="container notice-panel__inner">
    <div class="notice-panel__content">
      <h2 class="notice-panel__title">{notice.title}</h2>

      {notice.reason && (
        <p class="notice-panel__message">{notice.reason}</p>
      )}
    </div>

    {hasDetail && (
      <div class="notice-panel__detail">
        <p class="notice-panel__eyebrow">{detailLabel}</p>

        <p class="notice-panel__datetime">
          {detailDate && <span>{detailDate}</span>}

          {detailDate && detailTime && (
            <span
              class="notice-panel__separator"
              aria-hidden="true"
            >
              •
            </span>
          )}

          {detailTime && <span>{detailTime}</span>}
        </p>
      </div>
    )}
  </div>
</div>


<style>
  /* Base */

  .notice-panel {
    --notice-background: var(--color-negative);
    --notice-text: var(--color-deep-brown);
    --notice-muted: var(--color-deep-brown);
    --notice-accent: var(--color-deep-brown);
    --notice-divider: rgba(52, 38, 37, 0.25);

    background: var(--notice-background);
    color: var(--notice-text);
  }

  /* Variants */

  .notice-panel--closed {
    --notice-background: var(--color-negative);
    --notice-text: var(--color-deep-brown);
    --notice-muted: var(--color-deep-brown);
    --notice-accent: var(--color-deep-brown);
    --notice-divider: rgba(52, 38, 37, 0.25);
  }

  .notice-panel--event {
    --notice-background: var(--color-deep-brown);
    --notice-text: var(--color-white);
    --notice-muted: var(--color-cream-white);
    --notice-accent: var(--color-gold);
    --notice-divider: rgba(246, 242, 233, 0.25);
  }

  /* Layout */

  .notice-panel__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(32px, 6vw, 96px);
    padding-block: 24px;
  }

  /* Main content */

  .notice-panel__content {
    min-width: 0;
  }

  .notice-panel__title {
    margin: 0;
    color: var(--notice-text);
    font-family: var(--font-body);
    font-size: 20px;
    font-weight: 500;
    line-height: 1.2;
  }

  .notice-panel__message {
    max-width: 620px;
    margin: 4px 0 0;
    color: var(--notice-muted);
    font-size: 16px;
    line-height: 1.6;
  }

  /* Reopening panel */

  .notice-panel__detail {
    min-width: 0;
    padding-left: 32px;
    border-left: 1px solid var(--notice-divider);
    text-align: right;
  }

  .notice-panel__eyebrow {
    margin: 0 0 4px;
    color: var(--notice-text);
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .notice-panel__datetime {
    display: flex;
    align-items: baseline;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: 12px;
    margin: 0;
    color: var(--notice-accent);
    font-family: var(--font-heading);
    font-size: clamp(18px, 2.2vw, 24px);
    font-weight: 400;
    line-height: 1.15;
  }

  .notice-panel__separator {
    font-family: var(--font-body);
    font-size: 0.5em;
  }

  /* Mobile */

  @media (max-width: 760px) {
    .notice-panel__inner {
      grid-template-columns: 1fr;
      gap: 24px;
      padding-block: 28px;
    }

    .notice-panel__detail {
      padding: 20px 0 0;
      border-left: 0;
      border-top: 1px solid var(--notice-divider);
      text-align: left;
    }

    .notice-panel__datetime {
      justify-content: flex-start;
      font-size: clamp(24px, 6vw, 32px);
    }
  }
</style>
