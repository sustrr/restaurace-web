---
interface Variant {
  volume?: string;
  price: number;
}

interface Drink {
  code?: string;
  name: string;
  description?: string;
  variants: Variant[];
  allergens: number[];
  published: boolean;
}

interface Props {
  item: Drink;
}

const { item } = Astro.props;
---

<article class="drink-item">
  <div class="drink-item__content">
    <div class="drink-item__heading">
      {item.code && <span class="drink-item__code">{item.code}</span>}
      <h3>{item.name}</h3>
    </div>

    {item.description && <p class="drink-item__description">{item.description}</p>}

    {item.allergens.length > 0 && (
      <p class="drink-item__allergens">{item.allergens.join(", ")}</p>
    )}
  </div>

  <div class="drink-item__variants">
    {item.variants.map((variant) => (
      <div class="drink-item__variant">
        <span class="drink-item__volume">{variant.volume}</span>
        <span class="drink-item__price">{variant.price} Kč</span>
      </div>
    ))}
  </div>
</article>

<style>

.drink-item {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 1.5rem;
  padding: 0.9rem 0;
  border-bottom: 1px solid rgba(52, 38, 37, 0.12);
}

.drink-item__content {
  flex: 1;
  min-width: 0;
}

.drink-item__heading {
  display: grid;
  grid-template-columns: max-content minmax(0, 1fr);
  align-items: baseline;
  column-gap: 0.75rem;
}

.drink-item__heading h3 {
  font-size: 1.2rem;
  min-width: 0;
  margin: 0;
  overflow-wrap: break-word;
}

.drink-item__code {
  white-space: nowrap;
}

.drink-item__description {
  margin: 0.35rem 0 0;
  font-size: 0.875rem;
  line-height: 1.6;
  color: var(--color-warm-grey);
}

.drink-item__allergens {
  margin: 0.35rem 0 0;
  font-size: 0.75rem;
  color: var(--color-warm-grey);
}

.drink-item__variants {
  display: flex;
  flex-shrink: 0;
  flex-direction: column;
  gap: 0.4rem;
}

.drink-item__variant {
  display: flex;
  justify-content: flex-end;
  align-items: baseline;
  gap: 1rem;
  white-space: nowrap;
}

.drink-item__volume {
  font-size: 0.875rem;
  color: var(--color-warm-grey);
}

.drink-item__price {
  font-size: 1rem;
  font-weight: 600;
  color: var(--color-deep-brown);
  white-space: nowrap;
  text-align: right;
  font-variant-numeric: tabular-nums;
  min-width: 4rem;
}

@media (max-width: 480px) {
  .drink-item {
    gap: 0.75rem;
  }

  .drink-item__heading {
    column-gap: 1rem;
  }

  .drink-item__variant {
    gap: 0.5rem;
  }

  .drink-item__price {
    font-size: 0.9375rem;
    min-width: 3.5rem;
  }
}

</style>