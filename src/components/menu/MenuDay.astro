
---
import type { CollectionEntry } from 'astro:content';

type MenuDay =
  CollectionEntry<'weeklyMenu'>['data']['days'][number];

interface Props {
  day: MenuDay;
}

const { day } = Astro.props;

const dayNames = {
  monday: 'Pondělí',
  tuesday: 'Úterý',
  wednesday: 'Středa',
  thursday: 'Čtvrtek',
  friday: 'Pátek',
};
---

<article class="menu-day">

  {day.closed ? (
    <p class="menu-day__closed">Zavřeno</p>
  ) : (
    <>
      <h5 class="menu-day__meal-eyebrow ">Polévky</h5>
      <ul class="menu-day__meals">
        {day.soups.map((soup) => (
          <li class="menu-day__meal">
            <div class="menu-day__meal-info">
              <span class="menu-day__meal-name">
                {soup.name}
              </span>
            </div>

            <div class="menu-day__price">
              {soup.price} Kč
            </div>
          </li>
        ))}
      </ul>

      <h5 class="menu-day__meal-eyebrow ">Hlavní chody</h5>
      <ul class="menu-day__meals">
        {day.meals.map((meal) => (
          <li class="menu-day__meal">
            <div class="menu-day__meal-info">
              <span class="menu-day__meal-name">
                {meal.name}
              </span>
              <p class="menu-day__meal-description">{meal.description}</p>
            </div>

            <div class="menu-day__allergens">
              {meal.allergens && (
                  <span>{meal.allergens}</span>
              )}
            </div>

            <div class="menu-day__price">
              {meal.price} Kč
            </div>
          </li>
        ))}
      </ul>
    </>
  )}
</article>
