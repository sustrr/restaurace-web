
---
import type { CollectionEntry } from 'astro:content';
import PhoneContact from './PhoneContact.astro';

interface Props {
  event: CollectionEntry<'events'>;
  variant?: 'featured' | 'compact';
}

const { event, variant = 'featured' } = Astro.props;

const {
  title,
  startDate,
  endDate,
  description,
  image,
} = event.data;


const formatDate = (date: Date, options: Intl.DateTimeFormatOptions) =>
  new Intl.DateTimeFormat('cs-CZ', {
    timeZone: 'Europe/Prague',
    ...options,
  }).format(date);

const sameMonth =
  endDate &&
  startDate.getFullYear() === endDate.getFullYear() &&
  startDate.getMonth() === endDate.getMonth();

const sameYear =
  endDate &&
  startDate.getFullYear() === endDate.getFullYear();

const dateLabel = !endDate
  ? formatDate(startDate, { day: 'numeric', month: 'long', year: 'numeric' })
  : sameMonth
    ? `${formatDate(startDate, { day: 'numeric' })}–${formatDate(endDate, { day: 'numeric', month: 'long', year: 'numeric' })}`
    : sameYear
      ? `${formatDate(startDate, { day: 'numeric', month: 'long' })} – ${formatDate(endDate, { day: 'numeric', month: 'long', year: 'numeric' })}`
      : `${formatDate(startDate, { day: 'numeric', month: 'long', year: 'numeric' })} – ${formatDate(endDate, { day: 'numeric', month: 'long', year: 'numeric' })}`;

---

{variant === 'featured' ? (
  <article class="event-card event-card--featured">
    <div class="event-card__media">
      {image && (
        <img
          src={image}
          alt={title}
          class="event-card__image"
          loading="lazy"
        />
      )}
    </div>

    <div class="event-card__content">
      <p class="event-card__eyebrow">Sezónní nabídka &bull; <strong>{dateLabel}</strong></p>

      <h3 class="event-card__title">{title}</h3>

      <p class="event-card__description">{description}</p>

      <PhoneContact
  variant="light"
  description="Rezervujte si místo"
/>
    </div>
  </article>
) : (
  <article class="event-card-compact">
  <p class="event-card-compact__date">{dateLabel}</p>

  <div class="event-card-compact__content">
    <h3 class="event-card-compact__title">{title}</h3>
    <p class="event-card-compact__description">{description}</p>
  </div>
</article>
)}
