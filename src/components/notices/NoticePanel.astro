
---
import type { CollectionEntry } from 'astro:content';

interface Props {
  notice: CollectionEntry<'notices'>['data'];
}

const { notice } = Astro.props;

const isClosed = notice.type === 'closed';
const label = isClosed ? 'Zavřeno' : 'Uzavřená společnost';
---

<div
  class:list={[
    'notice-panel',
    {
      'notice-panel--closed': isClosed,
      'notice-panel--private': !isClosed,
    },
  ]}
  role="status"
>
  <div class="container notice-panel__inner">
    <span class="notice-panel__label">{label}</span>

    <span class="notice-panel__message">
      {notice.reason || notice.title}
    </span>
  </div>
</div>
