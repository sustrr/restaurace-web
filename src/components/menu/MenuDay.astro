
---
import type { CollectionEntry } from 'astro:content';

type WeeklyMenuDay =
  CollectionEntry<'weeklyMenu'>['data']['days'][number];

type MenuDay = WeeklyMenuDay & {
  restaurantClosed?: boolean;
  closureMessage?: string;
};

interface Props {
  day: MenuDay;
}

const { day } = Astro.props;
---

<article class="menu-day">

  {day.restaurantClosed ? (
    <div class="menu-day__status">
      <p class="menu-day__closed">
        Restaurace je uzavřena
      </p>

      {day.closureMessage && (
        <p class="menu-day__message">
          {day.closureMessage}
        </p>
      )}
    </div>

  ) : day.noLunchMenu ? (
    <div class="menu-day__status">
      <p class="menu-day__unavailable">
        Polední menu nepodáváme
      </p>

      {day.message && (
        <p class="menu-day__message">
          {day.message}
        </p>
      )}
    </div>

  ) : (
    <>
      {day.message && (
        <p class="menu-day__message">
          {day.message}
        </p>
      )}

      <h5 class="menu-day__meal-eyebrow">Polévky</h5>

      <ul class="menu-day__meals">
        {day.soups.map((soup) => (
          <li class="menu-day__meal">
            <div class="menu-day__meal-info">
              <span class="menu-day__meal-name">
                {soup.name}
              </span>
            </div>
          </li>
        ))}
      </ul>

      <h5 class="menu-day__meal-eyebrow">Hlavní chody</h5>

      <ul class="menu-day__meals">
        {day.meals.map((meal) => (
          <li class="menu-day__meal">
            <div class="menu-day__meal-info">
              <span class="menu-day__meal-name">
                {meal.name}
              </span>

              {meal.description && (
                <p class="menu-day__meal-description">
                  {meal.description}
                </p>
              )}
            </div>

            <div class="menu-day__allergens">
              {meal.allergens && (
                <span>{meal.allergens}</span>
              )}
            </div>

            <div class="menu-day__price">
              {meal.price} Kč
            </div>
          </li>
        ))}
      </ul>
    </>
  )}

</article>
